          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "http://localhost:9200/user_behavior/_search",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"size\": 0,\n  \"aggs\": {\n    \"location_distribution\": {\n      \"terms\": {\n        \"field\": \"location_name\"\n      }\n    }\n  }\n}"
            }
          }
        },
        {
          "name": "用户行为时间分布（按小时）",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
